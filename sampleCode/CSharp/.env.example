# IMPLAN Impact API credentials.
#
# Copy this file to `.env` in the same folder and fill in the two values below.
# `.env` is listed in .gitignore and must never be committed: it holds a working
# login for your IMPLAN account.
#
#     cp .env.example .env          (macOS, Linux)
#     copy .env.example .env        (Windows)
#
# These are the same credentials you use at app.implan.com. Your subscription has
# to include API access; if a login that works in the browser is refused here,
# that is usually why. Contact support@implan.com or your Customer Success
# Manager to have it enabled.

IMPLAN_USERNAME="your.name@example.com"
IMPLAN_PASSWORD="your-password"

# Optional. Leave this out unless IMPLAN has given you a different host to use.
# IMPLAN_API_URL="https://api.implan.com"
